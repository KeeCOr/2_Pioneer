{
    "name": "pioneer",
    "version": "1.8.2",
    "description": "Pioneer: ocean trade and fleet-management simulation game.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "test": "node --test",
        "build": "vite build",
        "preview": "vite preview",
        "serve": "npx http-server dist -p 8000 -o",
        "electron": "electron electron/main.cjs",
        "build:steam": "npm run build && electron-builder --config electron-builder.config.cjs",
        "dist:steam": "npm run build && electron-builder --config electron-builder.config.cjs --publish never"
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "zod": "^4.5.4",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.0.0",
        "autoprefixer": "^10.4.16",
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "http-server": "^14.1.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.3.0",
        "vite": "^5.0.0"
    },
    "optionalDependencies": {
        "steamworks.js": "^0.3.1"
    }
}
